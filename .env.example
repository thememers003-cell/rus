# RiseUp Solutions - Environment Configuration Example
# Copy this file to .env.local for local development

# Application Information
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="RiseUp Solutions"
NEXT_PUBLIC_COMPANY_TAGLINE="Technology That Moves You Forward."

# Centralized Contact Details
NEXT_PUBLIC_CONTACT_EMAIL=riseupsolutions@zohomail.in
NEXT_PUBLIC_INFO_EMAIL=info@riseupsolutions.in
NEXT_PUBLIC_HR_EMAIL=hr@riseupsolutions.in
NEXT_PUBLIC_CONTACT_PHONE="+91 9700429966"
NEXT_PUBLIC_CONTACT_HOURS="Monday to Saturday, 9:00 AM – 7:00 PM IST"

# Server-Side Email / Notification Recipients
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=notifications@riseupsolutions.in
EMAIL_TO_ADDRESS="riseupsolutions@zohomail.in, info@riseupsolutions.in"
CRM_WEBHOOK_URL=
